{
  "name": "sms-launcher",
  "version": "0.1.10",
  "private": true,
  "author": "sms-port contributors",
  "license": "MIT",
  "desktopName": "sms-launcher.desktop",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Desktop setup, build, update, and play launcher for sms-pc-port",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test",
    "dist": "electron-builder",
    "release": "node scripts/release.js"
  },
  "build": {
    "appId": "dev.chasem.smslauncher",
    "productName": "SMS Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "syncDesktopName": true,
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
